<section class="w-full py-16 md:py-20 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-5">

        <!-- Section Heading -->
        <div class="w-full md:w-7/12 lg:w-7/12 mx-auto text-center mb-12">

            <h5 class="text-[12px] lg:text-[16px] uppercase text-[#416BFA] leading-[16px] tracking-[0.2em] font-[600] mb-4">
                {{digiKioskSecurity.heading}}
            </h5>

            <h1 class="text-[32px] lg:text-[48px] font-[800]  text-gray-900">
                {{digiKioskSecurity.title}}
            </h1>

        </div>


        <!-- Security Cards -->
        <div class="flex flex-col md:flex-row justify-center gap-6 lg:gap-8 mt-10">

            {{#each digiKioskSecurity.items}}

            <div class="w-full md:w-1/3 mb-4">

                <div
                    class="
                        flex
                        flex-col
                        sm:flex-row
                        items-center
                        text-center
                        gap-4
                        p-6
                        h-full
                        rounded-xl
                        transition-all
                        duration-300
                        hover:-translate-y-1
                        hover:shadow-lg
                    "
                >

                    <!-- Icon -->
                    <div class="shrink-0">

                        <img
                            src="{{image}}"
                            alt="{{imageAlt}}"
                            class="w-[64px] h-[64px] rounded-[50px] md:w-[80px] md:h-[80px] bg-[#2EBC68] object-contain"
                        >

                    </div>


                    <!-- Content -->
                    <div>

                        <h3 class="text-[18px] font-[700] text-gray-900 mb-2 text-start">
                            {{title}}
                        </h3>

                        <p class="text-[16px] leading-7 text-gray-600 text-start">
                            {{description}}
                        </p>

                    </div>

                </div>

            </div>

            {{/each}}

        </div>

    </div>

</section>