<section class="w-full py-14 sm:py-16 md:py-20 lg:py-24 bg-white overflow-hidden">

    <!-- Heading -->
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

        <div class="max-w-4xl mx-auto text-center">

            <h5
                class="text-[14px] sm:text-[15px] md:text-[16px]
                       font-[600] tracking-[3px] text-black uppercase
                       mb-4 wow fadeInUp"
                data-wow-delay=".4s"
            >
                {{multilingualMobileHero.label}}
            </h5>

            <h1
                class="text-[32px] sm:text-[40px] md:text-[48px] lg:text-[52px]
                       leading-[1.15] font-[800] text-[#416BFA]
                       wow fadeInUp"
                data-wow-delay=".3s"
            >
                {{multilingualMobileHero.title}}
            </h1>

        </div>


        <!-- Card Image + Background Text -->
        <div
            class="relative w-full max-w-[1000px]
                   h-[390px] sm:h-[450px] md:h-[520px] lg:h-[580px]
                   mx-auto mt-8 md:mt-12"
        >

            <!-- Background Text -->
            <div
                class="absolute inset-0 z-0
                       flex items-center justify-center
                       pointer-events-none overflow-hidden"
            >

                <h2
                    class="text-center font-[800]
                           leading-[0.95]
                           text-[#F3F3F3]
                           text-[55px]
                           sm:text-[70px]
                           md:text-[95px]
                           lg:text-[125px]
                           xl:text-[145px]"
                >
                    Get your<br>
                    instant mobile<br>
                    application
                </h2>

            </div>


            <!-- Rupay Card Image -->
            <div
                class="absolute inset-0 z-10
                       flex items-center justify-center"
            >

                <img
                    src="{{multilingualMobileHero.image}}"
                    alt="{{multilingualMobileHero.imageAlt}}"
                    class="w-auto
                           h-[250px]
                           sm:h-[300px]
                           md:h-[370px]
                           lg:h-[440px]
                           object-contain"
                >

            </div>

        </div>


        <!-- Description -->
        <div class="max-w-4xl mx-auto text-center mt-4 md:mt-6">

            <h2
                class="text-[18px]
                       sm:text-[20px]
                       md:text-[22px]
                       lg:text-[24px]
                       leading-[1.6]
                       font-[400]
                       text-[#333]
                       wow fadeInUp"
                data-wow-delay=".4s"
            >
                {{multilingualMobileHero.description}}
            </h2>

        </div>

    </div>

</section>