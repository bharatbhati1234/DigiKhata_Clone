<section class="dk-features-section w-full px-5 py-12 md:py-16 lg:py-20" id="dk-features">

    <!-- Heading -->
    <div class="w-full md:w-7/12 mx-auto text-center">

        <div class="section-heading">

            <h1
                class="text-[32px] lg:text-[48px] font-[800] leading-tight"
                data-wow-delay=".3s"
            >
                {{cobrandPrepaidCardBenefits.title}}
            </h1>

        </div>

        <p
            class="mt-4 mb-10 text-[16px] leading-7 text-gray-600"
            data-wow-delay=".4s"
        >
            {{cobrandPrepaidCardBenefits.description}}
        </p>

    </div>


    <!-- Features Container -->
    <div class="dk-container w-full max-w-6xl mx-auto">

        <div
            class="
                dk-features-grid
                grid
                grid-cols-1
                sm:grid-cols-2
                gap-5
                md:gap-6
            "
        >

            {{#each cobrandPrepaidCardBenefits.cards}}

                <!-- Feature Card -->
                <div
                    class="
                        dk-feature-card
                        w-full
                      
                    "
                >

                    <div
                        class="
                            dk-card-content
                            flex
                            flex-col
                            sm:flex-row
                            items-center
                            sm:items-start
                            bg-[#F0F3FF]
                            rounded-[10px]
                            gap-5
                            p-5
                            md:p-6
                        "
                    >

                        <!-- Icon -->
                        <div class="dk-card-icon w-[70px] h-[70px] flex justify-center items-center shrink-0 bg-[#416BFA] rounded-full">

                            <img
                                src="{{icon}}"
                                alt="{{iconAlt}}"
                                class="dk-icon-img  w-[35px] h-[35px]"
                            >

                        </div>


                        <!-- Text -->
                        <div
                            class="
                                dk-card-text
                                text-center
                                sm:text-left
                            "
                        >

                            <h3
                                class="
                                    dk-card-title
                                    text-[24px]
                                   
                                    font-semibold
                                    leading-tight
                                "
                            >
                                {{title}}
                            </h3>

                            <p
                                class="
                                    dk-card-desc
                                    mt-2
                                    lg:text-[18px]
                                    text-[16px]
                                    leading-[1.6]
                                    text-gray-600
                                "
                            >
                                {{description}}
                            </p>

                        </div>

                    </div>

                </div>

            {{else}}

                <p class="col-span-full text-center text-gray-500">
                    No features available.
                </p>

            {{/each}}

        </div>

    </div>

</section>