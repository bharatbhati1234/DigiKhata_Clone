<div class="block scroll-reveal">
    <a
        href="{{appStore.link}}"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center bg-white px-5 py-3 rounded-md border-r-4 border-b-4 border-orange-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
    >
        <img
            src="{{appStore.image}}"
            alt="{{appStore.alt}}"
            class="h-10 w-auto object-contain"
        >
    </a>
</div>