<section class="w-full py-16 md:py-20 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-5">

        <!-- Section Heading -->
        <div class="w-full md:w-7/12 lg:w-7/12 mx-auto text-center mb-12">

            <h5 class="text-[12px] lg:text-[16px] tracking-[0.2rem] uppercase  font-[600] text-[#416BFA] mb-4">
                {{digiKioskServices.heading}}
            </h5>

            <h1 class="text-[32px] lg:text-[48px] font-[800] text-gray-900">
                {{digiKioskServices.title}}
            </h1>

        </div>


        <!-- Services Content -->
        <div class="flex flex-col md:flex-row justify-center items-end gap-8 md:gap-10 mt-10">


            <!-- Left Column -->
            <div class="w-full lg:w-[364px] md:w-5/12 px-4 md:px-2 rounded-[15px]">

                {{#each digiKioskServices.leftServices}}

                <div class="mb-8 bg-[#F4F4F4] p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5 ">

                        <div class=" w-[60px] h-[60px] lg:w-[70px] lg:h-[70px]  bg-[white] rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                              
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Description -->
                    <p class="text-start text-[16px] lg:text-[22px] font-[600]  lg:leading-[33px] leading-[24px] text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>


            <!-- Right Column -->
            <div class="w-full md:w-5/12 px-4 md:px-3">

                {{#each digiKioskServices.rightServices}}

                <div class="mb-8 bg-[#F4F4F4] max-w-[364px] p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px] bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Description -->
                    <p class="text-start lg:text-[22px] text-[16px] font-[600] leading-7 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}


                <!-- Bottom Text -->
                <div class="mt-8 text-center max-w-[348px] border-t border-black pt-[25px]">

                    <p class="text-[20px] md:text-[24px] text-start lg:text-[26px] font-[600] leading-8 text-gray-900">
                        {{digiKioskServices.bottomText}}
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>