<section class="w-full py-16 md:py-20 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-5">

        <!-- Section Heading -->
        <div class="w-full md:w-7/12 lg:w-7/12 mx-auto text-center mb-12">

            <h5 class="text-[18px] md:text-[20px] font-medium text-gray-900 mb-4">
                {{digiKioskServices.heading}}
            </h5>

            <h1 class="text-[32px] md:text-[42px] lg:text-[48px] font-[700] leading-tight text-gray-900">
                {{digiKioskServices.title}}
            </h1>

        </div>


        <!-- Services Content -->
        <div class="flex flex-col md:flex-row justify-center items-end gap-8 md:gap-10 mt-10">


            <!-- Left Column -->
            <div class="w-full md:w-5/12 px-4 md:px-2">

                {{#each digiKioskServices.leftServices}}

                <div class="mb-8">

                    <!-- Image -->
                    <div class="w-full flex justify-center mb-5">

                        <div class="w-[120px] h-[120px] md:w-[140px] md:h-[140px] rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-full h-full object-contain"
                            >

                        </div>

                    </div>


                    <!-- Description -->
                    <p class="text-center text-[15px] md:text-[16px] leading-7 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>


            <!-- Right Column -->
            <div class="w-full md:w-5/12 px-4 md:px-3">

                {{#each digiKioskServices.rightServices}}

                <div class="mb-8">

                    <!-- Image -->
                    <div class="w-full flex justify-center mb-5">

                        <div class="w-[120px] h-[120px] md:w-[140px] md:h-[140px] rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-full h-full object-contain"
                            >

                        </div>

                    </div>


                    <!-- Description -->
                    <p class="text-center text-[15px] md:text-[16px] leading-7 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}


                <!-- Bottom Text -->
                <div class="mt-8 text-center">

                    <p class="text-[20px] md:text-[24px] lg:text-[26px] font-[600] leading-8 text-gray-900">
                        {{digiKioskServices.bottomText}}
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>