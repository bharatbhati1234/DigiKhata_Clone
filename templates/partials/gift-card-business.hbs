<section class="w-full py-16 md:py-20 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-5">

        <!-- Section Heading -->
        <div class="w-full md:w-7/12 lg:w-7/12 mx-auto text-center mb-8 md:mb-10">

            <h1 class="text-[32px] md:text-[40px] lg:text-[48px] font-[800] text-gray-900 leading-tight">
                {{giftCardBusiness.title}}
            </h1>

        </div>


        <!-- UseCases Content -->
        <div class="flex flex-col md:flex-row justify-center items-start gap-4 md:gap-8 lg:gap-10 mt-8 md:mt-10">


            <!-- Left Column -->
            <div class="w-full md:w-5/12 px-2 md:px-3 md:pt-16">

                {{#each giftCardBusiness.leftServices}}

                <div class="mb-8 bg-[#F4F4F4] w-full max-w-[348px] mx-auto p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px] bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] font-[600] font-unbounded text-gray-900 mb-3">
                        {{heading}}
                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>



            <!-- Middle Column -->
            <div class="w-full md:w-5/12 px-2 md:px-3 md:pt-16">

                {{#each giftCardBusiness.middleServices}}

                <div class="mb-8 bg-[#F4F4F4] w-full max-w-[348px] mx-auto p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px] bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] font-[600] font-unbounded text-gray-900 mb-3">
                        {{heading}}
                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>



            <!-- Right Column -->
            <div class="w-full md:w-5/12 px-2 md:px-3 md:pt-16">

                {{#each giftCardBusiness.rightServices}}

                <div class="mb-8 bg-[#F4F4F4] w-full max-w-[348px] mx-auto p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px] bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] font-[600] font-unbounded text-gray-900 mb-3">
                        {{heading}}
                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>


        </div>

    </div>

</section>