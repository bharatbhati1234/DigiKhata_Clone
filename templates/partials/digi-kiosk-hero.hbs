<section class="w-full py-16 md:py-20 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-5">

        <!-- Heading -->
        <div class="text-center max-w-5xl mx-auto">

            <h5 class="text-[18px] md:text-[20px] font-medium text-gray-900 mb-4">
                {{digiKioskHero.label}}
            </h5>

            <h1 class="text-[40px] md:text-[56px] lg:text-[64px] font-[700] leading-tight">
                {{digiKioskHero.title}}
            </h1>

            <p class="mt-5 text-[16px] md:text-[18px] leading-7 text-gray-600">
                {{digiKioskHero.description}}
            </p>

        </div>


        <!-- Image -->
        <div class="max-w-5xl mx-auto mt-10">

            <img
                src="{{digiKioskHero.image}}"
                alt="{{digiKioskHero.imageAlt}}"
                class="w-full h-auto object-contain"
            >

        </div>


        <!-- Content -->
        <div class="max-w-3xl mx-auto text-center mt-10">

            <h2 class="text-[28px] md:text-[36px] font-[700] leading-tight">
                {{digiKioskHero.subTitle}}
            </h2>

            <p class="mt-4 text-[16px] md:text-[18px] leading-7 text-gray-600">
                {{digiKioskHero.subDescription}}
            </p>

        </div>

    </div>

</section>