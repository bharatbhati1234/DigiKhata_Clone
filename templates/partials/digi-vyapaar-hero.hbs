<section class="w-full py-16 md:py-20 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-6 ">

        <!-- Heading -->
        <div class="text-center max-w-4xl mx-auto">

            <h5 class="text-[12px] md:text-[16px] font-[600] leading-[16px] tracking-[0.2rem] text-gray-800 uppercase mb-4">
                {{digiVyapaarHero.label}}
            </h5>

            <h1 class="text-[32px]  md:text-[56px] lg:leading-[64px] font-[800] md:leading-[50px] text-[#416BFA]">
                {{digiVyapaarHero.title}}
            </h1>

            <p class="mt-5  text-[16px] lg:ml-[280px] lg:mr-[280px] md:text-[18px] leading-7 text-[#4b4a4a]">
                {{digiVyapaarHero.description}}
            </p>

        </div>


        <!-- Image -->
        <div class="max-w-5xl mx-auto mt-10">

            <img
                src="{{digiVyapaarHero.image}}"
                alt="{{digiVyapaarHero.imageAlt}}"
                class="w-[919px] h-auto object-contain"
            >

        </div>


        <!-- Content -->
        <div class="max-w-3xl mx-auto text-center mt-10">

            <h2 class="text-[24px] lg:text-[32px] md:text-[36px] font-[500] leading-tight">
                {{digiVyapaarHero.subTitle}}
            </h2>

            <p class="mt-4 text-[16px] md:text-[18px] text-[#4b4a4a]">
                {{digiVyapaarHero.subDescription}}
            </p>

        </div>

    </div>

</section>