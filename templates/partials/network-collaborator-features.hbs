<section class="w-full py-16 md:py-20 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-5">

        <!-- Section Heading -->
        <div class="w-full md:w-7/12 lg:w-7/12 mx-auto text-center mb-12">

            <h1 class="text-[32px] md:text-[40px] lg:text-[48px] font-[800] text-gray-900">
                {{networkCollaboratorFeatures.title}}
            </h1>

        </div>


        <!-- Features Content -->
        <div class="flex flex-col md:flex-row justify-center items-center gap-6 lg:gap-8 mt-10">


            <!-- LEFT COLUMN -->
            <div class="w-full md:w-5/12 lg:w-[348px] px-2 md:px-0
                        md:translate-y-12 lg:translate-y-16">

                {{#each networkCollaboratorFeatures.leftServices}}

                <div class="mb-8 w-full bg-[#F4F4F4] p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px]
                                    bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] font-[600] font-unbounded text-gray-900 mb-3">
                        {{heading}}
                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>



            <!-- MIDDLE COLUMN -->
            <div class="w-full md:w-5/12 lg:w-[348px] px-2 md:px-0">

                {{#each networkCollaboratorFeatures.middleServices}}

                <div class="mb-8 w-full bg-[#F4F4F4] p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px]
                                    bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] font-[600] font-unbounded text-gray-900 mb-3">
                        {{heading}}
                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>



            <!-- RIGHT COLUMN -->
            <div class="w-full md:w-5/12 lg:w-[348px] px-2 md:px-0
                        md:translate-y-12 lg:translate-y-16">

                {{#each networkCollaboratorFeatures.rightServices}}

                <div class="mb-8 w-full bg-[#F4F4F4] p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px]
                                    bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] font-[600] font-unbounded text-gray-900 mb-3">
                        {{heading}}
                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>

        </div>

    </div>

</section>