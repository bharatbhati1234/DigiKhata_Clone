<section class="block mobileApp w-full py-12 md:py-16 lg:py-20">

    <div class="container container-lg max-w-7xl mx-auto px-5">

        <!-- Heading -->
        <div class="w-full md:w-7/12 mx-auto text-center">

            <div class="section-heading">

                <h1
                    class="text-[32px] lg:text-[48px] font-[800] leading-tight"
                    
                >
                    {{expenseManagementBenefits.title}}
                </h1>

            </div>

            <p
                class="mt-4 mb-10 text-[16px] leading-7 text-gray-600"
                data-wow-delay=".4s"
            >
                {{expenseManagementBenefits.description}}
            </p>

        </div>


        <!-- Image + Benefits -->
        <div
            class="
                flex
                flex-col
                lg:flex-row
                justify-center
                items-center
                gap-10
                lg:gap-16
                py-4
            "
        >

            <!-- Card Image -->
            <div
                class="
                    w-full
                    lg:w-5/12
                    flex
                    justify-center
                    order-0
                "
            >

                <div class="testimonials-i">

                    <img
                        src="{{expenseManagementBenefits.image}}"
                        alt="{{expenseManagementBenefits.imageAlt}}"
                        class="
                            w-full
                            max-w-[350px]
                            h-auto
                            object-contain
                            mb-4
                            lg:mb-0
                        "
                    >

                </div>

            </div>


            <!-- Benefits -->
            <div
                class="
                    w-full
                    lg:w-5/12
                    lg:ml-8
                    order-1
                "
            >

                <div class="mt-3 ">

                    {{#each expenseManagementBenefits.points}}

                        <div
                            class="
                                mb-5
                                flex
                                items-start
                                gap-3
                            "
                        >

                            <!-- Check Icon -->
                            <div
                                class="
                                    shrink-0
                                    mt-1
                                    w-5
                                    h-5
                                    bg-[#416BFA]
                                    rounded-full
                                    flex
                                    items-center
                                    justify-center
                                "
                            >

                                <svg
                                    width="12"
                                    height="10"
                                    viewBox="0 0 12 10"
                                    fill="none"
                                >
                                    <path
                                        d="M1 5L4.5 8.5L11 1"
                                        stroke="white"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                    ></path>
                                </svg>

                            </div>


                            <!-- Point Content -->
                            <div>

                                <div
                                    class="
                                        leading-[1.4]
                                        text-black
                                        text-lg
                                        md:text-xl
                                    "
                                >
                                    <strong>{{title}}</strong>
                                </div>

                                <div
                                    class="
                                        leading-[1.5]
                                        text-black
                                        mt-1
                                        text-sm
                                        md:text-base
                                    "
                                >
                                    {{description}}
                                </div>

                            </div>

                        </div>

                    {{else}}

                        <p class="text-gray-500">
                            No benefits available.
                        </p>

                    {{/each}}

                </div>

            </div>

        </div>

    </div>

</section>