<!-- Download App Modal -->
<div
    id="download-modal"
    class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 px-4"
>

    <!-- Modal Box -->
    <div
    id="download-modal-content"
    class="relative w-full max-w-[748px] bg-white rounded-[5px] shadow-2xl
           -translate-y-20 opacity-0 transition-all duration-500 ease-out"
      >

        <!-- Close Button -->
        <button
            id="close-download-modal"
            type="button"
            class="absolute top-[-12px] right-[-12px] bg-[#416BFA] rounded-[50px] z-10 w-9 h-9 flex items-center justify-center cursor-pointer"
            aria-label="Close"
        >
            <img
                src="{{downloadModal.closeIcon}}"
                alt="{{downloadModal.closeAlt}}"
                class="w-5 h-5 brightness-0 invert"
            >
        </button>


        <!-- Modal Body -->
        <div class="px-5 py-10 md:px-10 md:py-12">

            <!-- Heading -->
            <div class="text-center mb-10">

                <h2
                    class="text-[32px] md:text-[40px] font-[700] leading-tight text-black"
                >
                    {{downloadModal.title}}
                </h2>

            </div>


            <!-- Google and App Store Buttons -->
            <div class="flex flex-wrap items-center justify-center gap-10">

                <!-- Google Play -->
                <a
                    href="{{downloadModal.googlePlay.link}}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center bg-white p-[6px_30px] border border-black rounded-[50px] border-r-4 border-b-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
                >
                    <img
                        src="{{downloadModal.googlePlay.image}}"
                        alt="{{downloadModal.googlePlay.alt}}"
                        class="h-10 md:h-12 w-auto object-contain"
                    >
                </a>


                <!-- Apple Store -->
                <a
                    href="{{downloadModal.appleStore.link}}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center bg-white p-[6px_30px] rounded-[50px] border border-black border-r-4 border-b-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
                >
                    <img
                        src="{{downloadModal.appleStore.image}}"
                        alt="{{downloadModal.appleStore.alt}}"
                        class="h-10 md:h-12 w-auto object-contain"
                    >
                </a>

            </div>

        </div>

    </div>

</div>