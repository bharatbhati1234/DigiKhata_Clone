<section class="w-full py-16 lg:py-24 block scroll-reveal">

    <div
        class="
            w-11/12
            mx-auto
            overflow-hidden
            rounded-[48px]
            bg-[#F4F4F4]
        "
    >

        <div
            class="
                flex
                flex-col
                xl:flex-row
                items-stretch
            "
        >

            <!-- Content -->

            <div
                class="
                    w-full
                    xl:w-5/12
                    flex
                    flex-col
                    justify-center
                    px-6
                    py-12
                    md:px-10
                    xl:px-0
                    xl:mx-auto
                "
            >

                <div class="mb-8">

                    <h5
                        class="
                            text-[20px]
                            font-medium
                            text-[#416BFA]
                            mb-3
                        "
                    >
                        {{kioskSection.label}}
                    </h5>


                    <h2
                        class="
                            text-3xl
                            md:text-4xl
                            lg:text-[40px]
                            leading-tight
                            font-[700]
                            text-gray-900
                        "
                    >
                        {{kioskSection.title}}
                    </h2>

                </div>


                <!-- Button -->

                <div>

                    <a
                        href="{{kioskSection.buttonLink}}"
                        class="
                            inline-block
                            px-6
                            py-3
                            text-[15px]
                            font-semibold
                            text-gray-900
                            bg-transparent
                            border-2
                            border-gray-900
                            border-r-4
                            border-b-4
                            rounded-[50px]
                            hover:bg-gray-900
                            hover:text-white
                            transition
                        "
                    >
                        {{kioskSection.buttonText}}
                    </a>

                </div>

            </div>


            <!-- Image -->

            <div
                class="
                    w-full
                    xl:w-6/12
                    p-0
                "
            >

                <img
                    src="{{kioskSection.image}}"
                    alt="{{kioskSection.imageAlt}}"
                    class="
                        w-full
                        h-full
                        min-h-[300px]
                        xl:min-h-[420px]
                        object-cover
                        object-left
                    "
                >

            </div>

        </div>

    </div>

</section>