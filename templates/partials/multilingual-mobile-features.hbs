<section class="w-full py-12 sm:py-16 lg:py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section Heading -->
        <div class="w-full md:w-7/12 mx-auto text-center mb-10 sm:mb-14">

            <h2
                class="text-3xl sm:text-4xl md:text-5xl lg:text-[48px]
                       font-bold leading-tight text-gray-900
                       wow fadeInUp"
                data-wow-delay=".3s"
            >
                {{multilingualMobileFeatures.title}}
            </h2>

        </div>


        <!-- Features -->
        <div class="space-y-12 sm:space-y-16 lg:space-y-20">

            {{#each multilingualMobileFeatures.items}}

            <div
                class="
                    grid grid-cols-1 lg:grid-cols-2
                    gap-8 lg:gap-16
                    items-center
                    max-w-5xl mx-auto
                "
            >

                <!-- Text -->
                <div
                    class="
                        {{#if reverse}}
                            lg:order-2
                        {{else}}
                            lg:order-1
                        {{/if}}
                        text-center lg:text-left
                        wow zoomIn
                    "
                    data-wow-delay=".2s"
                >

                    <h3
                        class="
                            text-2xl sm:text-3xl lg:text-[40px]
                            font-bold
                            text-gray-900
                            leading-tight
                            mb-4
                        "
                    >
                        {{title}}
                    </h3>

                    <p
                        class="
                            text-base sm:text-lg
                            leading-7
                            text-gray-600
                            max-w-xl
                            mx-auto lg:mx-0
                        "
                    >
                        {{description}}
                    </p>

                </div>


                <!-- Image -->
                <div
                    class="
                        {{#if reverse}}
                            lg:order-1
                        {{else}}
                            lg:order-2
                        {{/if}}

                        flex justify-center
                        wow zoomIn
                    "
                    data-wow-delay=".3s"
                >

                    <img
                        src="{{image}}"
                        alt="{{imageAlt}}"
                        class="
                            w-full
                            max-w-[280px]
                            sm:max-w-[320px]
                            md:max-w-[350px]
                            lg:max-w-[380px]
                            h-auto
                            object-contain
                            transition-transform
                            duration-300
                            hover:scale-105
                        "
                    >

                </div>

            </div>

            {{/each}}

        </div>

    </div>
</section>