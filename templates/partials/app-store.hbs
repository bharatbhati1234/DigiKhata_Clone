<section class="w-full py-16 md:py-20 overflow-hidden block scroll-reveal">

    {{!-- Social Media Icons --}}
    <div class="flex justify-center items-center gap-4 mt-8 mb-4">

        {{#each socialLinks}}

        <a
            href="{{url}}"
            target="_blank"
            rel="noopener noreferrer"
            title="{{name}}"
            class="w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 bg-[#f4f4f4] flex items-center justify-center rounded-full border-none border-gray-300 text-gray-700 {{hover}} transition-all duration-300 hover:-translate-y-1"
        >
            <i class="fa {{icon}}"></i>
        </a>

        {{/each}}

    </div>


    {{!-- Heading --}}
    <div class="max-w-7xl mx-auto px-5">

        <div class="w-full md:w-1/2 mx-auto text-center mb-8">

            <h2
                id="textChanger"
                class="text-[40px] md:text-[64px] font-[800] leading-tight"
            >
                {{accountSection.title}}
            </h2>

            <p class="mt-4 text-[16px] leading-7 text-gray-600">
                {{accountSection.description}}
            </p>

        </div>

    </div>


    {{!-- Download App Section --}}
    <div class="relative w-full overflow-hidden py-8">

        {{!-- Black Moving Text --}}
        <div class="absolute inset-0 flex items-center overflow-hidden">

            <div class="flex w-max animate-download-scroll">

                <div class="flex items-center shrink-0">

                    {{#each socialLinks}}
                    <h2 class="px-6 md:px-12 text-[24px] md:text-[30px] font-unbounded font-[500] whitespace-nowrap text-black">
                        {{../downloadSlider.text}}
                    </h2>
                    {{/each}}

                </div>

                <div class="flex items-center shrink-0">

                    {{#each socialLinks}}
                    <h2 class="px-6 md:px-12 text-[24px] md:text-[30px] font-unbounded font-[500] whitespace-nowrap text-black">
                        {{../downloadSlider.text}}
                    </h2>
                    {{/each}}

                </div>

            </div>

        </div>


        {{!-- Center Button / White Text --}}
        <div class="relative z-20 flex justify-center">

            <a
                href="javascript:void(0)"
                id="download-app-slider"
                class="relative flex items-center justify-center
                       w-[280px] md:w-[300px]
                       h-[70px] md:h-[85px]
                       rounded-full
                       bg-blue-600
                       overflow-hidden
                       cursor-pointer"
            >

                {{!-- White Moving Text --}}
                <div class="absolute inset-0 flex items-center overflow-hidden">

                    <div class="flex w-max animate-download-scroll">

                        <div class="flex items-center shrink-0">

                            {{#each socialLinks}}
                            <h2 class="px-6 md:px-12 text-[24px] md:text-[30px] font-unbounded font-[500] whitespace-nowrap text-white">
                                {{../downloadSlider.text}}
                            </h2>
                            {{/each}}

                        </div>

                        <div class="flex items-center shrink-0">

                            {{#each socialLinks}}
                            <h2 class="px-6 md:px-12 text-[24px] md:text-[30px] font-[500] whitespace-nowrap text-white">
                                {{../downloadSlider.text}}
                            </h2>
                            {{/each}}

                        </div>

                    </div>

                </div>

            </a>

        </div>

    </div>

</section>