<section class="w-full py-16 block scroll-reveal" id="Section12">

    <div class="max-w-5xl mx-auto px-5">

        <div id="accordioncontent" class="space-y-4">

            {{#each faq}}

            <div class="group border border-gray-200 rounded-xl overflow-hidden">

                <button
                    type="button"
                    class="faq-question w-full flex items-center justify-between gap-4 px-6 py-5 text-left font-medium text-gray-800 hover:bg-gray-50 transition"
                >

                    <span
                        class="faq-title flex items-center gap-3 text-[18px] font-[600] group-hover:text-[#416BFA] transition-colors duration-200 cursor-pointer"
                    >

                        <i
                            class="fa fa-question rounded-[50px] text-[black] group-hover:text-[white] group-hover:bg-[#416BFA] p-[10px_15px]"
                        ></i>

                        {{question}}

                    </span>

                    <span
                        class="faq-icon text-xl transition-transform duration-300"
                    >
                        +
                    </span>

                </button>


                <div class="faq-answer hidden px-6 pb-5">

                    <p class="text-gray-600 leading-7">

                        {{#if link}}

                            {{answerBefore}}

                            <a
                                href="{{link}}"
                                target="_blank"
                                class="text-blue-600 hover:underline"
                            >
                                {{linkText}}
                            </a>

                            {{answerAfter}}

                        {{else}}

                            {{answer}}

                        {{/if}}

                    </p>

                </div>

            </div>

            {{/each}}

        </div>

    </div>

</section>