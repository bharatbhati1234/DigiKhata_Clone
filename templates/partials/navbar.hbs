<header id="site-header" class="sticky top-0 z-50 w-full bg-white border-none">

    <nav class="max-w-7xl mx-auto px-5 ">

        <div class="h-[72px] flex items-center justify-between">

            <!-- Logo -->

            <a href="/" class="flex items-center">
                <img src="{{logo}}" alt="DigiKhata" class="w-[180px] h-[54px]">
            </a>


            <!-- Desktop Navigation -->

            <div id="desktop-navigation" class="hidden lg:flex  items-center gap-6 ">

                <ul class="flex items-center gap-6 ">

                    {{#each navigation}}

                    <li class="relative nav-item ">

                        {{#if dropdown}}

                        <button type="button"
                            class="dropdown-toggle font-unbounded flex text-[16px] font-[400] items-center gap-1 py-3  text-black hover:text-[#0f388f] transition">

                            {{name}}

                            <span class="dropdown-arrow text-xs transition-transform duration-200">
                                ▼
                            </span>

                        </button>


                        <!-- Dropdown -->

                        <div
                            class="dropdown-menu hidden absolute left-0 top-full mt-2 w-64 bg-[#416BFA] font-unbounded border border-gray-200 rounded-lg shadow-xl py-2 ">

                            {{#each items}}

                            <a href="{{link}}" {{#if external}} target="_blank" rel="noopener noreferrer" {{/if}}
                                class="block px-5 py-3 text-[16px] text-white hover:bg-gray-50 hover:text-blue-600 transition">
                                {{name}}
                            </a>

                            {{/each}}

                        </div>

                        {{else}}

                        <a href="{{link}}" class="font-unbounded nav-link py-3 text-[16px] text-black hover:text-[#0f388f] transition">
                            {{name}}
                        </a>

                        {{/if}}

                    </li>

                    {{/each}}

                </ul>


                <!-- Download Button -->

                <button id="download-app" type="button"
                    class=" rounded-[50px]  text-[14px] font-unbounded py-[7px] px-[30px] bg-[#416BFA] text-white hover:bg-[#0f388f]  transition-all duration-[400ms] ease-in-out cursor-pointer">
                    {{downloadButton.text}}
                </button>


                <!-- Accessibility -->

                <div class="flex items-center gap-1 bg-[#141414A6] p-[8px] rounded-[30px] shadow-[0_8px_25px_rgba(0,0,0,0.25)]" id="desktop-accessibility">

                    <button type="button" class="accessibility-btn text-[14px] font-[600] p-[8px_12px] text-white border border-white/15 rounded-[50px] transition-all hover:bg-[#416BFA] hover:border-[#416BFA] hover:-translate-y-0.5" data-action="increase" title="Increase Font Size">
                        A+
                    </button>

                    <button type="button" class="accessibility-btn text-[14px] font-[600] p-[8px_12px] text-white border border-white/15 rounded-[50px] transition-all hover:bg-[#416BFA] hover:border-[#416BFA] hover:-translate-y-0.5" data-action="decrease" title="Decrease Font Size">
                        A-
                    </button>

                    <button type="button" class="accessibility-btn text-[14px] font-[600] p-[8px_12px] text-white border border-white/15 rounded-[50px] transition-all hover:bg-[#416BFA] hover:border-[#416BFA] hover:-translate-y-0.5" data-action="reset" title="Reset">
                        Reset
                    </button>

                    <button type="button" class="accessibility-btn p-[8px_12px] border border-white/15 rounded-[50px] transition-all hover:bg-[#416BFA] hover:border-[#416BFA] hover:-translate-y-0.5" data-action="theme" title="Toggle Dark Mode">
                        🌓
                    </button>

                </div>

            </div>


            <!-- Mobile Hamburger -->

            <button id="mobile-menu-button" type="button" class="lg:hidden flex flex-col gap-1.5 p-2"
                aria-label="Toggle navigation" aria-expanded="false">

                <span class="w-6 h-0.5 bg-gray-800"></span>
                <span class="w-6 h-0.5 bg-gray-800"></span>
                <span class="w-6 h-0.5 bg-gray-800"></span>

            </button>

        </div>


        <!-- Mobile Navigation -->

        <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 py-4">

            <ul class="flex flex-col">

                {{#each navigation}}

                <li class="mobile-nav-item">

                    {{#if dropdown}}

                    <button type="button"
                        class="mobile-dropdown-toggle w-full flex items-center justify-between py-3 text-left text-gray-700">

                        <span>{{name}}</span>

                        <span>▼</span>

                    </button>


                    <div class="mobile-dropdown hidden pl-4">

                        {{#each items}}

                        <a href="{{link}}" {{#if external}} target="_blank" rel="noopener noreferrer" {{/if}}
                            class="block py-2 text-sm text-gray-600 hover:text-blue-600">
                            {{name}}
                        </a>

                        {{/each}}

                    </div>

                    {{else}}

                    <a href="{{link}}" class="block py-3 text-gray-700 hover:text-blue-600">
                        {{name}}
                    </a>

                    {{/if}}

                </li>

                {{/each}}


                <!-- Mobile Download -->

                <li class="pt-3">

                    <button type="button" class="w-full py-3 rounded-lg bg-blue-600 text-white">
                        {{downloadButton.text}}
                    </button>

                </li>


                <!-- Mobile Accessibility -->

                <li class="pt-4">

                    <div class="border-t border-gray-200 pt-4">

                        <p class="text-sm font-medium text-gray-700 mb-3">
                            Accessibility
                        </p>

                        <div class="flex gap-2">

                            <button class="accessibility-btn" data-action="increase">
                                A+
                            </button>

                            <button class="accessibility-btn" data-action="decrease">
                                A-
                            </button>

                            <button class="accessibility-btn" data-action="reset">
                                Reset
                            </button>

                            <button class="accessibility-btn" data-action="theme">
                                Dark Mode
                            </button>

                        </div>

                    </div>

                </li>

            </ul>

        </div>

    </nav>

</header>