<section class="w-full py-16 lg:py-24">

    <div class="max-w-7xl mx-auto px-5">

        {{#each instantRupayCardTransactions}}

        <div class="
        flex
        flex-col
        md:flex-row
        items-center
        justify-around
        gap-10
        lg:gap-16
        mb-20
        lg:mb-28
        {{#if reverse}}
            md:flex-row-reverse
        {{/if}}
    ">

            <!-- TEXT -->

            <div class="
                        w-full
                        md:w-5/12
                        text-center
                        md:text-left
                        {{#if @index}}
                        order-0
                        {{else}}
                        order-0
                        {{/if}}
                    block scroll-reveal">

                <div>

                    <h2 class="
                                text-3xl
                                lg:text-[40px]
                                leading-tight
                                font-[700]
                                text-gray-900
                                
                               
                            ">
                        {{title}}
                    </h2>

                </div>


                <p class="
                            py-4
                            text-base
                            leading-7
                            text-gray-600
                            block scroll-reveal
                        ">
                    {{description}}
                </p>


                <a href="{{link}}" class="
                            inline-block
                            p-[10px_30px]
                            rounded-[50px]
                            font-unbounded
                            text-black
                            bg-white
                            text-sm
                            border-r-4 border-b-4 border-black
                            border
                            font-medium
                            hover:bg-[#416BFA]
                            hover:text-white
                            transition-all duration-300 ease-linear hover:-translate-y-[0.25em]">
                    {{buttonText}}
                </a>

            </div>


            <!-- IMAGE -->

            <div class="
                        w-full
                        md:w-6/12
                        flex
                        justify-center
                        {{#if @odd}}
                        md:order-0
                        {{else}}
                        md:order-1
                        {{/if}}
                    ">

                <img src="{{image}}" alt="{{imageAlt}}" class="
                            w-full
                            max-w-lg
                            h-auto
                            object-contain
                            pt-3
                        ">

            </div>

        </div>

        {{/each}}

    </div>

</section>