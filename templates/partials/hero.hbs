<section
    id="hero"
    class="relative w-full overflow-hidden bg-white"
>

    <!-- Slides Container -->

    <div
        id="hero-slides"
        class="relative lg:min-h-[650px] min-h-[1100px]"
    >

        {{#each heroSlides}}

            <div
                class="hero-slide absolute inset-0 opacity-0 invisible transition-all duration-700"
                data-slide="{{@index}}"
            >

                <div
                    class="max-w-7xl h-full mx-auto px-5"
                >

                    <div
                        class="min-h-[650px] flex flex-col lg:flex-row items-center justify-between gap-10 block scroll-reveal"
                    >

                        <!-- LEFT CONTENT -->

                        <div
                            class="w-full lg:w-1/2 pt-20 lg:pt-0 text-center"
                        >

                            <div class="overflow-hidden">

                                <h5
                                    class="hero-category text-[14px] tracking-[3px] uppercase text-[#416BFA] font-[600] mb-4"
                                >
                                    {{category}}
                                </h5>

                            </div>


                            <div class="overflow-hidden">

                                <h2
                                    class="hero-title text-[56px] md:text-5xl lg:text-[56px] leading-[60px] font-[800] mb-6"
                                >
                                    {{title}}
                                </h2>

                            </div>


                            <div class="overflow-hidden">

                                <p
                                    class="hero-description text-lg lg:text-xl leading-relaxed text-gray-600 mb-8 max-w-xl"
                                >
                                    {{description}}
                                </p>


                                <a
                                    href="{{link}}"
                                    class="inline-block px-6 py-3 rounded-[50px] bg-blue-600 text-white text-[16px] font-unbounded font-medium hover:bg-blue-700 transition"
                                >
                                    {{buttonText}}
                                </a>

                            </div>

                        </div>


                        <!-- RIGHT IMAGE -->

                        <div
                            class="w-full lg:w-1/2 flex justify-center"
                        >

                            <div
                                class="hero-image-wrapper w-full max-w-xl"
                            >

                                <img
                                    src="{{image}}"
                                    alt="{{imageAlt}}"
                                    class="w-full h-auto object-contain"
                                >

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        {{/each}}

    </div>


    <!-- Carousel Dots -->

    <div
        id="hero-dots"
        class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-3"
    >

        {{#each heroSlides}}

            <button
                type="button"
                class="hero-dot w-3 h-3 rounded-full bg-gray-300 transition-all duration-300"
                data-slide="{{@index}}"
                aria-label="Go to slide {{@index}}"
            >
            </button>

        {{/each}}

    </div>


    <!-- Previous Button -->

    <button
        id="hero-prev"
        type="button"
        class="absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-gray-100 transition"
        aria-label="Previous slide"
    >
        ←
    </button>


    <!-- Next Button -->

    <button
        id="hero-next"
        type="button"
        class="absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-gray-100 transition"
        aria-label="Next slide"
    >
        →
    </button>

</section>