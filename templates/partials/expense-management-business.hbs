<section class="w-full py-10 md:py-14 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-5">

        <!-- Section Heading -->
        <div class="w-full lg:w-[700px] mx-auto text-center mb-6 md:mb-8">

            <h1 class="text-[32px] md:text-[40px] lg:text-[48px] leading-[1.15] font-[800] text-gray-900">
                {{expenseManagementBusiness.title}}
            </h1>

        </div>


        {{!-- Paragraph --}}

        <div class="text-center max-w-4xl mx-auto mb-6 md:mb-8">

            <p class="text-[16px] md:text-[18px] leading-7 text-[#4b4a4a] lg:px-[80px]">
                {{expenseManagementBusiness.description1}}
            </p>

        </div>


        <!-- UseCases Content -->
        <div class="flex flex-col md:flex-row justify-center items-center md:items-stretch gap-5 lg:gap-6 mt-6">


            <!-- Left Column -->
            <div class="w-full md:w-[348px] flex flex-col justify-center">

                {{#each expenseManagementBusiness.leftServices}}

                <div class="w-full min-h-[280px] mb-6 last:mb-0 bg-[#F4F4F4] p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px] bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] leading-7 font-[600] font-unbounded text-gray-900 mb-3">

                        {{heading}}

                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">

                        {{description}}

                    </p>

                </div>

                {{/each}}

            </div>


            <!-- Middle Column -->
            <div class="w-full md:w-[348px] flex flex-col">

                {{#each expenseManagementBusiness.middleServices}}

                <div class="w-full min-h-[280px] mb-6 last:mb-0 bg-[#F4F4F4] p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px] bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] leading-7 font-[600] font-unbounded text-gray-900 mb-3">

                        {{heading}}

                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">

                        {{description}}

                    </p>

                </div>

                {{/each}}

            </div>


            <!-- Right Column -->
            <div class="w-full md:w-[348px] flex flex-col">

                {{#each expenseManagementBusiness.rightServices}}

                <div class="w-full min-h-[280px] mb-6 last:mb-0 bg-[#F4F4F4] p-[25px] rounded-[15px]">

                    <!-- Image -->
                    <div class="w-full flex justify-start mb-5">

                        <div class="w-[60px] h-[60px] lg:w-[70px] lg:h-[70px] bg-white rounded-full flex items-center justify-center overflow-hidden">

                            <img
                                src="{{image}}"
                                alt="{{imageAlt}}"
                                class="w-[42px] h-[42px] object-contain"
                            >

                        </div>

                    </div>


                    <!-- Heading -->
                    <h4 class="text-[20px] leading-7 font-[600] font-unbounded text-gray-900 mb-3">

                        {{heading}}

                    </h4>


                    <!-- Description -->
                    <p class="text-start text-[16px] leading-6 text-gray-600">

                        {{description}}

                    </p>

                </div>

                {{/each}}

            </div>


        </div>

    </div>

</section>