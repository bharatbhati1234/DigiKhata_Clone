                <div class="w-full lg:w-7/12 order-1 lg:order-2 px-6 py-6 md:px-10 lg:px-6 block scroll-reveal">

                    <div class="pb-6">

                        <h2
                            class="text-[32px] md:text-[40px] lg:text-[45px] font-[700] text-center leading-tight text-white"
