<section class="w-full py-16 block scroll-reveal">

    <div class="max-w-7xl mx-auto px-5">


        <!-- Benefit Rows -->
        {{#each digiKhataUPITestimonials.items}}

        <div class="flex flex-col lg:flex-row justify-center items-center gap-8 lg:gap-16 mt-12">

            <!-- Text -->
            <div
                class="
                    w-full
                    lg:w-4/12
                    {{#if imageLeft}}
                        order-2 lg:order-2
                    {{else}}
                        order-2 lg:order-1
                    {{/if}}
                "
            >

                {{#each benefits}}

                <div class="mb-6 pb-5 border-b border-gray-200">

                    <h4 class="text-[24px] font-[700] text-gray-900 mb-3">
                        {{title}}
                    </h4>

                    <p class="text-[16px] md:text-[16px] text-gray-600">
                        {{description}}
                    </p>

                </div>

                {{/each}}

            </div>


            <!-- Image -->
            <div
                class="
                    w-full
                    md:w-8/12
                    lg:w-4/12
                    flex
                    justify-center
                    items-center
                    {{#if imageLeft}}
                        order-1 lg:order-1
                    {{else}}
                        order-1 lg:order-2
                    {{/if}}
                "
            >

                <img
                    src="{{image}}"
                    alt="{{imageAlt}}"
                    class="w-full lg:max-w-[350px] max-w-[236px] h-auto object-contain"
                >

            </div>

        </div>

        {{/each}}

    </div>

</section>